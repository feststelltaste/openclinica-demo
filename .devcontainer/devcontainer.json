{
  "name": "OpenClinica",
  "image": "ghcr.io/feststelltaste/openclinica-demo-devcontainer:latest",
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "redhat.telemetry.enabled": false,
        "editor.mouseWheelZoom": true,
        "terminal.integrated.mouseWheelZoom": true,
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "security.workspace.trust.enabled": false,
        "security.workspace.trust.startupPrompt": "never",
        "terminal.integrated.initialHint": false,
        "chat.disableAIFeatures": true,
        "chat.commandCenter.enabled": false,
        "chat.agent.enabled": false,
        "github.copilot.enable": {
          "*": false
        },
        "window.autoDetectColorScheme": false,
        "workbench.colorTheme": "Default Light Modern",
        "workbench.secondarySideBar.defaultVisibility": "hidden"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "onCreateCommand": "mkdir -p .vscode && cp .devcontainer/vscode/*.json .vscode/",
  "postCreateCommand": "(bash .devcontainer/setup-pi.sh || echo 'Pi setup failed, continuing')",
  "postStartCommand": [
    "bash",
    "-c",
    "for i in $(seq 1 60); do docker info >/dev/null 2>&1 && break; echo 'Waiting for Docker daemon...'; sleep 2; done; source docker/demo/base-url.sh && docker compose -f docker/docker-compose.demo.yml up -d && bash docker/demo/print-url.sh"
  ],
  "secrets": {
    "LITELLM_URL": {
      "description": "Base URL of the LLM API for the Pi coding agent, for example https://api.example.com/v1"
    },
    "LITELLM_API_KEY": {
      "description": "API key for the LLM API used by the Pi coding agent"
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "OpenClinica",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
