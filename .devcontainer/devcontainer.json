{
  "name": "OpenClinica",
  "image": "ghcr.io/feststelltaste/openclinica-demo-devcontainer:latest",
  "containerEnv": {
    "NPM_CONFIG_UPDATE_NOTIFIER": "false"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "redhat.telemetry.enabled": false,
        "chat.disableAIFeatures": true,
        "chat.commandCenter.enabled": false,
        "github.copilot.enable": {
          "*": false
        },
        "window.autoDetectColorScheme": false,
        "workbench.colorTheme": "Default Light Modern",
        "workbench.secondarySideBar.defaultVisibility": "hidden"
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "(bash .devcontainer/setup-pi.sh || echo 'Pi setup failed, continuing')",
  "postStartCommand": [
    "bash",
    "-c",
    "source docker/test/base-url.sh && docker compose -f docker-compose.demo.yml up -d && bash docker/test/print-url.sh"
  ],
  "secrets": {
    "LITELLM_URL": {
      "description": "Base URL of the LLM API for the Pi coding agent, for example https://api.example.com/v1"
    },
    "LITELLM_API_KEY": {
      "description": "API key for the LLM API used by the Pi coding agent"
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "OpenClinica",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
